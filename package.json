{
  "name": "coursecapture",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "node scripts/build-tokens.mjs",
    "i18n:check": "node scripts/check-messages.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium --project=phone",
    "media:capture": "playwright test --project=media",
    "media": "node scripts/build-marketing-media.mjs",
    "check": "pnpm tokens && pnpm i18n:check && pnpm lint && pnpm typecheck && pnpm test",
    "predev": "node scripts/build-tokens.mjs",
    "prebuild": "node scripts/build-tokens.mjs",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/supabase.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/mistral": "4.0.66",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "2.0.1",
    "ai": "7.0.143",
    "inngest": "4.24.0",
    "jspdf": "4.2.1",
    "jszip": "3.10.2",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "nodemailer": "10.0.14",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "server-only": "^0.0.1",
    "unpdf": "1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.5",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  }
}
