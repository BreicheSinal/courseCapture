# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only (stage 5)
# Local Supabase CLI only: Google sign-in
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# AI provider (server only) — see docs/ai.md
AI_PROVIDER=anthropic             # anthropic | openai | google | mistral | openai-compatible
AI_API_KEY=                       # key for AI_PROVIDER
AI_BASE_URL=                      # only for openai-compatible endpoints / gateways
AI_MODEL_DEFAULT=                 # course generation, diagrams
AI_MODEL_QUICK=                   # tutor
AI_MODEL_VISION=                  # optional; scanned PDFs (defaults to AI_MODEL_DEFAULT)

# Optional per-task overrides (leave empty to use the values above)
AI_TUTOR_PROVIDER=
AI_TUTOR_API_KEY=
AI_TUTOR_MODEL=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Email (server only) — approval emails via Resend (docs/setup-supabase.md)
RESEND_API_KEY=
EMAIL_FROM="CourseCapture <noreply@invixlab.tech>"

# App (used in sign-in links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database tests (pnpm test:db)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Limits
AI_DAILY_GENERATIONS_PER_TEACHER=
AI_DAILY_TUTOR_QUESTIONS_PER_STUDENT=
