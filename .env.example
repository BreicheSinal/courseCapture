# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only: the generation job and uploads
# Local Supabase CLI only: Google sign-in
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# AI provider (server only) — see docs/ai.md
AI_PROVIDER=                      # anthropic | openai | google | mistral | openai-compatible (fake: tests only); empty = from the key
AI_API_KEY=                       # key for AI_PROVIDER
AI_BASE_URL=                      # only for openai-compatible endpoints / gateways
AI_MODEL_DEFAULT=                 # course generation, diagrams
AI_MODEL_QUICK=                   # tutor
AI_MODEL_VISION=                  # optional; scanned PDFs (defaults to AI_MODEL_DEFAULT)

# Optional per-task overrides (leave empty to use the values above)
AI_TUTOR_PROVIDER=
AI_TUTOR_API_KEY=
AI_TUTOR_MODEL=

# Inngest (docs/ai.md → Running the job). Leave empty to run jobs right after the response.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=                       # 1 to use the local dev server (pnpm inngest:dev)

# Email (server only) — Google SMTP for approval emails (docs/setup-supabase.md)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=                         # the support address
SMTP_PASS=                         # Google app password, not the account password
EMAIL_FROM=                        # e.g. "CourseCapture <support@your-domain>"

# Contact form (/contact): where messages go (default: SMTP_USER), and an optional salt for the rate limit
CONTACT_EMAIL=
CONTACT_SALT=

# App (used in sign-in links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Service worker (offline reading) runs in production builds; set to 1 to try it in dev
NEXT_PUBLIC_SW=

# Database tests (pnpm test:db)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Daily limits per person (empty = defaults: 20 / 100 / 30)
AI_DAILY_GENERATIONS_PER_TEACHER=
AI_DAILY_DIAGRAMS_PER_TEACHER=
AI_DAILY_TUTOR_QUESTIONS_PER_STUDENT=
